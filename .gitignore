# ---- macOS 系统文件 ----
.DS_Store

# ---- 敏感凭据与登录态（严禁提交）----
# 多账号配置：含 Trae session/token、请求头等敏感字段
accounts.json
# 明文登录态文件（如 workbuddy-desktop.info 含 accessToken）
*.info
*.token
*.session
.env
.env.*
# Playwright 持久化浏览器上下文（含网页登录态 cookie）
.browser_state/
.browser_state_cookie/

# ---- 运行时产物与日志 ----
# 签到/launchd 日志
logs/
__pycache__/
*.pyc
*.pyo
# 应用偏好（签到时间、自动重试、刷新频率…）：本机个性化设置，App 运行时生成
native_prefs.json
# WorkBuddy IDE 生成的预览产物（PNG/HTML 临时图）
.workbuddy/preview/

# ---- 构建产物 ----
# 内置浏览器运行时（playwright + 依赖，约 140MB）：由 setup_browser.sh 重建，不进版本库
.venv/
# SwiftPM 构建中间产物（.build 下含大量 .o）
native/.build/
DerivedData/
*.o
# 打包产物（喵签签.app / AutoCheckin.app）
*.app

# ---- 临时/中间产物 ----
temp_*.json
*.bak
